# Copy this file to .env (or set these in your host's dashboard) and fill in the values.

# The live address of the website, with no trailing slash. Used for search-engine tags, the sitemap,
# and links in alert emails.
SITE_URL=https://www.jieweitech.com

NODE_ENV=production
PORT=3000

# Where the database file lives. On a container host, point this at a persistent volume (e.g. /data).
DATA_DIR=./data

# Behind a proxy or load balancer (Fly.io, Render, Railway, nginx, Cloudflare), keep this at 1 so visitor
# IP addresses and HTTPS are detected correctly. Set to 0 when the server faces the internet directly.
TRUST_PROXY=1

# First dashboard account, created on the first start if there are no accounts yet.
# The password must be at least 10 characters; you'll be asked to choose a new one when you first sign in.
# You can remove these two lines after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Email (optional, but needed for alerts and visitor confirmations) ----
# Any SMTP service works: Google Workspace, Microsoft 365, Postmark, SendGrid, Amazon SES, Resend, Mailgun…
# Either one URL:
#   SMTP_URL=smtps://username:password@smtp.example.com:465
# or the parts:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender shown on emails. Use an address on a domain your SMTP service is allowed to send for.
MAIL_FROM="JIEWEITECH <no-reply@jieweitech.com>"
# Where visitors' replies to the confirmation email go (for example your sales inbox).
MAIL_REPLY_TO=

# Default alert settings. Both can be changed later in the dashboard under Settings.
NOTIFY_EMAILS=
WEBHOOK_URL=

# Only if the website is hosted somewhere else (e.g. a static host) and posts its form to this server:
# the site's address(es), comma-separated.
ALLOWED_ORIGINS=

# Sign-in sessions end after this many hours without activity, and after this many days in any case.
SESSION_HOURS=12
SESSION_MAX_DAYS=7
